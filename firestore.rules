rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isFriendOf(userId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(userId));
    }

    function hasFriendRequest(senderId, recipientId) {
      return exists(/databases/$(database)/documents/users/$(recipientId)/friendRequests/$(senderId));
    }

    function validFriendDocument(friendId) {
      return request.resource.data.keys().hasOnly(['uid', 'displayName', 'addedAt'])
        && request.resource.data.uid == friendId
        && request.resource.data.displayName
          == get(/databases/$(database)/documents/profiles/$(friendId)).data.displayName;
    }

    function mutualFriendshipExistsAfter(userId, friendId) {
      return existsAfter(/databases/$(database)/documents/users/$(friendId)/friends/$(userId));
    }

    match /profiles/{userId} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.normalizedUsername is string;
      allow delete: if false;
    }

    match /friendCodes/{friendCode} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    match /learningPlans/{planId} {
      allow read: if signedIn() && resource.data.published == true;
      allow write: if false;

      match /entries/{entryId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/learningPlans/$(planId)).data.published == true;
        allow write: if false;
      }
    }

    match /news/{dayId} {
      allow read: if signedIn() && resource.data.published == true;
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /words/{wordId} {
        allow read: if isOwner(userId) || isFriendOf(userId);
        allow create, update, delete: if isOwner(userId);
      }

      match /vocabularyKeys/{keyId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /sentenceAttempts/{attemptId} {
        allow read, create: if isOwner(userId);
        allow update, delete: if false;
      }

      match /friends/{friendId} {
        allow read: if isOwner(userId);
        allow create: if validFriendDocument(friendId)
          && mutualFriendshipExistsAfter(userId, friendId)
          && (
            (isOwner(userId) && hasFriendRequest(friendId, userId))
            || (signedIn() && request.auth.uid == friendId && hasFriendRequest(userId, friendId))
          );
        allow update, delete: if isOwner(userId);
      }

      match /friendRequests/{senderId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if signedIn()
          && request.auth.uid == senderId
          && senderId != userId
          && request.resource.data.keys().hasOnly([
            'senderUid',
            'senderDisplayName',
            'recipientUid',
            'createdAt'
          ])
          && request.resource.data.senderUid == senderId
          && request.resource.data.recipientUid == userId
          && request.resource.data.senderDisplayName
            == get(/databases/$(database)/documents/profiles/$(senderId)).data.displayName;
      }
    }
  }
}
