{
  "name": "wordwise",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test lib/*.test.ts",
    "spoken-core:build": "node --experimental-strip-types scripts/build-spoken-core.ts",
    "spoken-core:check": "node --experimental-strip-types scripts/build-spoken-core.ts --check",
    "stage0:due": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types scripts/make-stage-zero-due.ts",
    "news:upload": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types scripts/upload-news.ts",
    "plan:upload": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types scripts/upload-learning-plan.ts",
    "learning-plans:upload": "npm run plan:upload --",
    "seed:plans:check": "node --experimental-strip-types scripts/seed-learning-plans.ts",
    "seed:plans": "node --experimental-strip-types scripts/seed-learning-plans.ts --write"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.17.1",
    "firebase-admin": "^13.10.0",
    "i18next": "^26.3.6",
    "next": "^16.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "resend": "^6.28.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.34.0",
    "eslint-config-next": "^16.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2"
  }
}
